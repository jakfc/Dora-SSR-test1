# ---------- Dora SSR 编译产物 ----------
# src/**/*.ts 会被引擎编译成同目录同名 .lua，属于构建产物，不入库。
# 改完 TS 后请先编译（见 README「开发流程」），保证本地运行的是最新代码。
*.lua

# ---------- 引擎/编辑器运行期文件 ----------
.agent/
.cache/
Image/
*.tga
*.log
imgui.ini
dora.db

# ---------- 本地临时产物（工具脚本生成，随时可重跑）----------
tools/_*.json
tools/_*.txt
__pycache__/
*.pyc
docs/_*.txt

# ---------- 参考资料（体积大、含第三方版权，仅本地保留）----------
参考/

# ---------- 第三方素材包 / 原始切片（来源与授权待确认，仅本地保留）----------
# 只把切好的成品放进 assets/，原始 tar 包与整页 jpg 源图不入库。
raw_assets/

# ---------- 系统与编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# 本地调试脚本与临时请求（自检脚本 `_probe_*.py` / `_probe_*.lua` 要留给协作者，
# 只忽略脚本生成的请求/输出文件）
tools/_*.json
tools/_*.txt
tools/__pycache__/

# 运行时自检探针：手写的 lua（不是编译产物），要随自检脚本一起入库
!tools/_probe_*.lua
!tools/_probe_*.py
!tools/dump_scene.lua
!tools/probe_keys.lua
